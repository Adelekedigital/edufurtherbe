# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets and local config
.env
.env.*
!.env.example

# Test, type, and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
junit.xml

# Bubble migration artefacts — contains member PII, never commit
data/
exports/
migration/out/
*.csv
# Root only. A catalogue snapshot is taken as `--from-file catalogue.json`
# here; the Bubble exports are covered by the directory rules above. Repo-wide
# `*.json` also swallowed `.claude/settings.json` and any test fixture, and
# `git add` refuses those without a word.
/*.json
!/.mcp.json
script-data-dev/

# Tooling leftovers
*.new
requirements-audit.txt
promptdump.md

# Local agent overrides (personal, not shared)
.claude/settings.local.json

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Per-environment files. Replaced whole, never edited a variable at a time —
# a half-updated set is the failure `config.py` now refuses to start on.
.env.staging
.env.production

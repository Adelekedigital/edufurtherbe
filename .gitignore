# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets and local config
.env
.env.*
!.env.example

# Test, type, and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
junit.xml

# Bubble migration artefacts — contains member PII, never commit
data/
exports/
migration/out/
*.csv
FE-ui-guide
# Root only. A catalogue snapshot is taken as `--from-file catalogue.json`
# here; the Bubble exports are covered by the directory rules above. Repo-wide
# `*.json` also swallowed `.claude/settings.json` and any test fixture, and
# `git add` refuses those without a word.
/*.json
!/.mcp.json
script-data-dev/

# Tooling leftovers
*.new
requirements-audit.txt
promptdump.md

# Local agent overrides (personal, not shared)
.claude/settings.local.json
# CLAUDE.md tells a second session to use `git worktree` rather than switching
# the shared checkout, and this is where they land. A worktree is a checkout of
# this same repository, so leaving it untracked put a full second copy of the
# tree into every repo-wide grep and into `git status`.
.claude/worktrees/

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Per-environment files. Replaced whole, never edited a variable at a time —
# a half-updated set is the failure `config.py` now refuses to start on.
.env.staging
.env.production

# Google OAuth material for the calendar spike. The client secret is downloaded
# from the Cloud console and the token is minted by consenting in a browser —
# neither is ours to commit, and both land in `scripts/` where the spike runs.
# The doubled suffix is not a typo: Windows appends `.json` to a file whose
# extension it is already hiding, and the real download is named that way.
scripts/client_secret*.json
scripts/*client_secret*
scripts/calendar_spike_token.json
# The id of the calendar a run created, so --cleanup-only can find it.
scripts/calendar_spike_state.json

# Worktrees a second session created at the repo root. `.claude/worktrees/`
# covers the sanctioned location; these do not live there, and `git add -A`
# stages one as an embedded git repository without being asked twice.
_wt*/

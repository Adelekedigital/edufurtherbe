# Copy to `.env` and adjust. `.env` is git-ignored; this file is not, so nothing
# real belongs in it — placeholders only.
#
# Every variable is EDUFURTHER_-prefixed and declared as a field on Settings in
# src/app/core/config.py. A misspelled prefixed variable fails at startup rather
# than silently leaving a default in place, so a typo here is loud.

EDUFURTHER_ENVIRONMENT=local
EDUFURTHER_DEBUG=false
EDUFURTHER_CORS_ORIGINS=["http://localhost:3000"]

# Matches docker-compose.yml, which is a throwaway local database on port 55432.
# The deployed DSN carries a real password, is a SecretStr, and never appears in
# a file that git tracks.
EDUFURTHER_DATABASE_URL=postgresql://edufurther:edufurther@localhost:55432/edufurther

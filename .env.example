# Copy to `.env` and adjust. `.env` is git-ignored; this file is not, so nothing
# real belongs in it — placeholders only.
#
# Every variable is declared as a field on Settings in src/app/core/config.py.
#
# Only ENVIRONMENT and DEBUG carry the EDUFURTHER_ prefix — they are generic
# enough that a host or a base image may already define them. Everything else
# names its own subject and stands alone.
#
# A leftover EDUFURTHER_ key from before that change fails at startup, naming its
# replacement. A misspelled *unprefixed* key does not, and cannot: it is
# indistinguishable from an unrelated variable. Check spellings here.
#
# ENV_FILE selects which file this one is copied to and read from — `.env` by
# default, or `ENV_FILE=.env.staging` for a whole environment at once:
#
#   ENV_FILE=.env.staging uv run python scripts/load_identity.py ...   # bash
#   $env:ENV_FILE=".env.staging"; uv run python scripts/...            # PowerShell
#
# Replace the file, never a variable at a time. DATABASE_URL, SUPABASE_URL and
# SUPABASE_JWKS_URL name a Supabase project, and Settings refuses to start if
# they name different ones — because pointing the DSN at staging while the
# Supabase keys still name production makes provision_auth create real accounts
# in the wrong project, and report success. A variable you forget to change is
# caught; one you forget to *include* is not, since an absent value cannot
# disagree with anything. That is why it is a file, not five edits.

EDUFURTHER_ENVIRONMENT=local
EDUFURTHER_DEBUG=false
# Either spelling works: a JSON array, or a plain comma-separated list.
# Unset or empty means no CORS middleware at all — same-origin only.
#   CORS_ORIGINS=http://localhost:3000,https://app.edufurther.org
CORS_ORIGINS=["http://localhost:3000"]

# Which provider template stands for which message, per channel. Either
# spelling works, exactly as above: a JSON object, or plain `key=value` pairs.
#
# Unset means no template, and a send then fails with a ConfigurationError
# naming the message — deliberately, because sending the wrong message is worse
# than sending none and a silent no-op would make a channel look configured.
#
# Two maps rather than one, because a message exists on email long before it
# exists on WhatsApp: nobody has a phone number yet.
#
# Every WhatsApp entry must be a template Meta has approved — every message this
# platform sends is business-initiated and so outside the 24-hour window.
#   EMAIL_TEMPLATES=mentor_response_reminder=tmpl_abc123
EMAIL_TEMPLATES={}
WHATSAPP_TEMPLATES={}

# Matches docker-compose.yml, which is a throwaway local database on port 55432.
# The deployed DSN carries a real password, is a SecretStr, and never appears in
# a file that git tracks.
DATABASE_URL=postgresql://edufurther:edufurther@localhost:55432/edufurther

# Supabase — Dashboard -> Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co

# Verifying incoming access tokens. Newer projects sign asymmetrically and
# publish a JWKS; older ones use a shared HS256 secret. Fill whichever your
# project shows under JWT Keys and leave the other blank — the verifier prefers
# the JWKS, and refuses to start if neither is set.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=

# Admin API, for the provisioning CLI only. This key bypasses RLS and can create
# and delete users. It is not the anon key, it never reaches a browser, and a
# real value never belongs in a tracked file.
SUPABASE_SERVICE_ROLE_KEY=

# Where re-hosted profile images live. Create this bucket once in the dashboard
# as a PUBLIC bucket; the migration script refuses to create it, because a script
# that can create a public bucket can publish a private one by typo.
SUPABASE_STORAGE_BUCKET=profile-images
